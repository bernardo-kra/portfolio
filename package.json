{
  "name": "portfolio",
  "private": false,
  "version": "0.0.0",
  "type": "module",
  "homepage": "https://bernardo-kra.github.io/",
  "scripts": {
    "dev": "vite",
    "dev:backend": "cd backend && npm run dev",
    "dev:full": "concurrently \"npm run dev\" \"npm run dev:backend\"",
    "typecheck": "tsc -b --pretty false",
    "build": "npm run typecheck && vite build",
    "build:backend": "cd backend && npm run build",
    "build:full": "npm run build && npm run build:backend",
    "lint": "eslint . --report-unused-disable-directives",
    "lint:fix": "eslint . --fix --report-unused-disable-directives",
    "lint:types": "eslint --config eslint.typed.config.mjs . --report-unused-disable-directives",
    "test": "node tests/qualityRules.verify.mjs && npm run build:backend && node --experimental-strip-types --test tests/*.test.mjs",
    "test:tasks": "node --experimental-strip-types --test tests/taskHistory.test.mjs",
    "test:neon": "node --experimental-strip-types --test tests/neonConsole.test.mjs tests/neonRender.test.mjs tests/neonMission.test.mjs",
    "test:privacy": "node --experimental-strip-types --test tests/privacy.test.mjs",
    "test:security": "npm run build:backend && node --experimental-strip-types --test tests/security.test.mjs tests/authSession.test.mjs tests/securityPolicy.test.mjs",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "date-fns": "^4.1.0",
    "lucide-react": "^0.482.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.6.3",
    "react-router-dom": "^7.6.3",
    "react-toastify": "^11.0.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.39.5",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@typescript-eslint/utils": "^8.71.1",
    "@vitejs/plugin-react-swc": "^3.8.0",
    "concurrently": "^9.1.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.15.0",
    "prettier": "^3.2.5",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^6.2.0"
  },
  "engines": {
    "node": "22.x"
  }
}
