---
alwaysApply: true
rule: react-dev-style
description: Regras para geração de código React
when:
  context: code_generation
  language: react
then:
  - preserve_structure: true
  - do_not_add_comments: true
  - do_not_remove_existing_comments: true
  - no_semicolons: true
  - change_only_when_requested: true
  - maintain_existing_functionality: true
  - preserve_dependencies_and_imports: true
  - keep_code_formatting: true

---
